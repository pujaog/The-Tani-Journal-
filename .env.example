# The Tani Journal environment variables
# Local: copy to .env
# Vercel: add each value in Project Settings -> Environment Variables

# ---------- PostgreSQL / Prisma ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tani_journal?schema=public"

# ---------- Auth.js ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32-byte AES key, encoded as base64 or 64 hex characters.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"

# ---------- Separate Socket.IO server ----------
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ---------- Existing Firebase/Mongo migration ----------
MONGO_URL="mongodb://localhost:27017"
DB_NAME="tani_journal"
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ---------- Optional ----------
ADMIN_EMAILS=""
CORS_ORIGINS="http://localhost:3000"
